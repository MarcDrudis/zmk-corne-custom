/*
 * Hand-wired 6-column Corne (21 keys/half, 42 total).
 *
 * Wiring (marc's build, nRF52840 SuperMini / nice!nano-compatible):
 *   Rows: qwert=P0.02, asdfg=P0.10, zxcvb=P0.09, thumbs=P1.00
 *   Cols (outer pinky -> index): 022=P0.22, qaz=P1.15, wsx=P1.13,
 *        edc/thumb2=P1.04, rfv/thumb1=P1.06, tgb/thumb0=P0.11
 *
 * Combined 12-column transform (left cols 0-5, right cols 6-11), matching
 * the upstream corne 6-column layout so the keymap's 42 positions line up.
 * Each half physically scans a 6-col x 4-row matrix; the split framework
 * offsets the right half's columns by +6 (see corne_custom_right.overlay
 * once you wire it). Thumbs are on local cols 3,4,5 (edc/rfv/tgb).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/*
 * The keymap is plain, natural QWERTY. The physical wiring quirk lives HERE,
 * in the single shared transform (the central/left owns it; the right half
 * just reports raw row/col and the central applies this map + col-offset=6).
 *
 * Both halves are wired columns outer-pinky -> index (local col 0 = outer).
 *   Left  reads naturally: keymap col 0 = physical col 0 (outer)  -> RC(r,0..5)
 *   Right must read center -> outer so the keymap can be normal (Y U I O P ..),
 *         so its 6 keymap slots point at physical cols in REVERSE: 5,4,3,2,1,0
 *         which, after col-offset=6, are transform cols 11,10,9,8,7,6.
 * Thumbs are physical cols 3,4,5 on each half.
 */

/ {
	/*
	 * ZMK Studio needs a chosen zmk,physical-layout (not a chosen
	 * zmk,matrix-transform). The layout's `transform` property still points at
	 * our custom default_transform below, so the reversed right-half column
	 * wiring is fully preserved — this is a relocation, not a rewrite. The
	 * `keys` geometry is the canonical foostan 6-col Corne (upstream
	 * dts/layouts/foostan/corne/6column.dtsi), in keymap-position order.
	 */
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical-layout = &physical_layout0;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Corne Custom";
		transform = <&default_transform>;
		keys  //                     w   h    x    y     rot    rx    ry
			= <&key_physical_attrs 100 100    0   37       0     0     0>
			, <&key_physical_attrs 100 100  100   37       0     0     0>
			, <&key_physical_attrs 100 100  200   12       0     0     0>
			, <&key_physical_attrs 100 100  300    0       0     0     0>
			, <&key_physical_attrs 100 100  400   12       0     0     0>
			, <&key_physical_attrs 100 100  500   24       0     0     0>
			, <&key_physical_attrs 100 100  800   24       0     0     0>
			, <&key_physical_attrs 100 100  900   12       0     0     0>
			, <&key_physical_attrs 100 100 1000    0       0     0     0>
			, <&key_physical_attrs 100 100 1100   12       0     0     0>
			, <&key_physical_attrs 100 100 1200   37       0     0     0>
			, <&key_physical_attrs 100 100 1300   37       0     0     0>
			, <&key_physical_attrs 100 100    0  137       0     0     0>
			, <&key_physical_attrs 100 100  100  137       0     0     0>
			, <&key_physical_attrs 100 100  200  112       0     0     0>
			, <&key_physical_attrs 100 100  300  100       0     0     0>
			, <&key_physical_attrs 100 100  400  112       0     0     0>
			, <&key_physical_attrs 100 100  500  124       0     0     0>
			, <&key_physical_attrs 100 100  800  124       0     0     0>
			, <&key_physical_attrs 100 100  900  112       0     0     0>
			, <&key_physical_attrs 100 100 1000  100       0     0     0>
			, <&key_physical_attrs 100 100 1100  112       0     0     0>
			, <&key_physical_attrs 100 100 1200  137       0     0     0>
			, <&key_physical_attrs 100 100 1300  137       0     0     0>
			, <&key_physical_attrs 100 100    0  237       0     0     0>
			, <&key_physical_attrs 100 100  100  237       0     0     0>
			, <&key_physical_attrs 100 100  200  212       0     0     0>
			, <&key_physical_attrs 100 100  300  200       0     0     0>
			, <&key_physical_attrs 100 100  400  212       0     0     0>
			, <&key_physical_attrs 100 100  500  224       0     0     0>
			, <&key_physical_attrs 100 100  800  224       0     0     0>
			, <&key_physical_attrs 100 100  900  212       0     0     0>
			, <&key_physical_attrs 100 100 1000  200       0     0     0>
			, <&key_physical_attrs 100 100 1100  212       0     0     0>
			, <&key_physical_attrs 100 100 1200  237       0     0     0>
			, <&key_physical_attrs 100 100 1300  237       0     0     0>
			, <&key_physical_attrs 100 100  350  312       0     0     0>
			, <&key_physical_attrs 100 100  450  312    1200   450   412>
			, <&key_physical_attrs 100 150  548  283    2400   548   433>
			, <&key_physical_attrs 100 150  752  283  (-2400)  852   433>
			, <&key_physical_attrs 100 100  850  312  (-1200)  950   412>
			, <&key_physical_attrs 100 100  950  312       0     0     0>
		;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;
		/* | left cols 0..5 (natural) |   | right cols reversed: 11..6 | */
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
                        RC(3,3) RC(3,4) RC(3,5)   RC(3,11) RC(3,10) RC(3,9)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;
		/* diode-direction + gpios set per-half in the .overlay files */
	};
};

/*
 * P0.09 / P0.10 are the nRF52840 NFC antenna pins by default. Rows are wired
 * to them (left 009+010, right 010), so free them for GPIO. On Zephyr 3.5
 * (ZMK v0.3) this is a devicetree property on UICR, not a Kconfig symbol.
 */
&uicr {
	nfct-pins-as-gpios;
};
