#include "corne_custom.dtsi"

/*
 * RIGHT HALF (peripheral).
 * Rows: yuiop=P0.31, hjkl;=P1.06, nm,./=P1.13, thumbs=P0.10
 * Cols (outer pinky -> index): 100=P1.00, 002=P0.02, 020=P0.20,
 *      024=P0.24, 011=P0.11, 104=P1.04
 * col-offset = <6> maps this half's local cols 0-5 to transform cols 6-11.
 * Match the diode-direction you settle on for the left half.
 */

&default_transform {
	col-offset = <6>;
};

&kscan0 {
	/* ---- col2row (DEFAULT) ---- */
	diode-direction = "col2row";

	row-gpios
		= <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* yuiop */
		, <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* hjkl; */
		, <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* nm,./ */
		, <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* thumbs */
		;
	col-gpios
		= <&gpio1 0  GPIO_ACTIVE_HIGH>	/* outer pinky */
		, <&gpio0 2  GPIO_ACTIVE_HIGH>	/* p ; / */
		, <&gpio0 20 GPIO_ACTIVE_HIGH>	/* o l . */
		, <&gpio0 24 GPIO_ACTIVE_HIGH>	/* edc / thumb2 */
		, <&gpio0 11 GPIO_ACTIVE_HIGH>	/* rfv / thumb1 */
		, <&gpio1 4  GPIO_ACTIVE_HIGH>	/* tgb / thumb0 */
		;

	/* ---- row2col (ALTERNATE) — uncomment this + comment the block above ----
	diode-direction = "row2col";
	col-gpios
		= <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
	row-gpios
		= <&gpio0 31 GPIO_ACTIVE_HIGH>
		, <&gpio1 6  GPIO_ACTIVE_HIGH>
		, <&gpio1 13 GPIO_ACTIVE_HIGH>
		, <&gpio0 10 GPIO_ACTIVE_HIGH>
		;
	*/
};
